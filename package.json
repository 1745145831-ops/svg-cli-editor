{
  "name": "svg-cli-editor",
  "version": "0.2.0",
  "private": true,
  "description": "PJ1 Phase 2: a plugin-based SVG CLI editor and VS Code SVG outline extension",
  "type": "module",
  "main": "dist/cli/main.js",
  "bin": {
    "svg-editor": "dist/cli/main.js"
  },
  "scripts": {
    "cli": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:vscode",
    "build:cli": "tsc -p tsconfig.build.json",
    "build:vscode": "node scripts/build-vscode.mjs",
    "package:vscode": "npm run build:vscode && npx @vscode/vsce package --no-dependencies --cwd vscode-extension",
    "start": "node dist/cli/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check:arch": "node scripts/check-architecture.mjs",
    "metrics": "node scripts/metrics.mjs",
    "verify:assembly": "node scripts/verify-assembly.mjs",
    "verify:compat": "node scripts/verify-compat.mjs",
    "check": "npm run typecheck && npm run check:arch && npm test && npm run build:vscode"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.146.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
