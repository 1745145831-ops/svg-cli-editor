{
  "name": "svg-cli-editor",
  "version": "0.1.0",
  "private": true,
  "description": "PJ1 Phase 1: an object-oriented, command-driven SVG editor for the terminal",
  "type": "module",
  "main": "dist/cli/main.js",
  "bin": {
    "svg-editor": "dist/cli/main.js"
  },
  "scripts": {
    "cli": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check:arch": "node scripts/check-architecture.mjs",
    "check": "npm run typecheck && npm run check:arch && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
